<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-2 sidebar">
        <h3 class="text-center py-3"></h3>
        <a href="/userdashboard?id=<%=data.id%>" class="active">Dashboard</a>
        <a href="/userprofile?id=<%=data.id%>">Profile</a>
        <a href="/studviewbook?id=<%=data.id%>">View Books</a>
        <a href="/issubook?id=<%=data.id%>">Issue  Books</a>
        <a href="/userLogin">Logout</a>
        
      </div>
      <div class="col-md-10">
          <div class="header d-flex justify-content-between align-items-center">
            <h4>User Dashboard</h4>
            <div>Hello,<%=data.name%>  </div>
          </div>
          <div class="container mt-5">
    

    <table class="table table-bordered">
            <thead>
              <tr>
                <th>request_id</th>
                <th>student_id</th>
                <th>book_id</th>
                <th>request_date</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="tBody">
             <% if (requests && requests.length === 0) { %>
            <tr>
        <td colspan="5"><h3>There is no data present in database</h3></td>
    </tr>
<% } else { %>
    <% requests.forEach((item) => { %>
    <tr>
        <td><%= item.request_id %></td>
        <td><%= item.student_id %></td>
        <td><%= item.book_id %></td>
        <td><%=  new Date(item.request_date).toDateString() %></td>
        
        <td>
    <% if (item.status === 'Approved') { %>
        <span class="badge bg-success"><%= item.status %></span>
    <% } else if (item.status === 'Rejected') { %>
        <span class="badge bg-danger"><%= item.status %></span>
    <% } else { %>
        <span class="badge bg-warning text-dark">Pending</span>
    <% } %>
</td>

    </tr>
    <% }); %>
<% } %>
</tbody>

          </table>
  </div>
    </div>
      </div>
      
  </div>
</body>
</html>
