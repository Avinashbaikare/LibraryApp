<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-2 sidebar">
        <h3 class="text-center py-3"></h3>
        <a href="/userdashboard?id=<%=data1.id%>" class="active">Dashboard</a>
        <a href="/userprofile?id=<%=data1.id%>">Profile</a>
        <a href="/studviewbook?id=<%=data1.id%>">View Books</a>
        <a href="/issubook?id=<%=data1.id%>">Issue  Books</a>
        <a href="/userLogin">Logout</a>
        
      </div>
      <div class="col-md-10">
          <div class="header d-flex justify-content-between align-items-center">
            <h4>User Dashboard</h4>
            <div>Hello,<%=data1.name%></div>
          </div>

  <div class="container mt-5">
    <!-- Example Book Card -->
    <table class="table table-bordered">
            <thead>
              <tr style="text-align: center; vertical-align: middle;">
                <th>Book Id</th>
                <th>image</th>
                <th>Title</th>
                <th>Author</th>
                <th>Catagory</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="tBody">
            <%
                if(data.length==0){
            %>
            <tr><td colspan="6"><h1>There is no data present in database </h1></td></tr>
            <%
                }
                else{
                data.forEach((item,index)=>{
            %>  
            <tr style="text-align: center; vertical-align: middle;">
                <td><%=(index+1)%></td>
                <td><img src="<%=item.image%>" style="width: 100px; height: 150px;"> </td>
                <td><%=item.title%></td>
                <td><%=item.author%></td>
                <td><%=item.category%></td>
                <td><%=item.status%></td>
                
                   <form action="/requestbook" method="POST">
                    <input type="hidden" name="student_id" value="<%= data1.id %>">
                    <input type="hidden" name="book_id" value="<%= item.id %>">
                    <td><button type="submit" class="btn btn-danger">Request book</button></td>
                   </form>
                   



            </tr>
            
            <%
                });
            }
            %>
            
        </tbody>
          </table>
  </div>

  <div class="footer">
    © 2025 Library Management System
  </div>
</body>
</html>
