<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>View Books - Library</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: #f4f6fa;
      font-family: 'Segoe UI', sans-serif;
    }
    .header {
      background: linear-gradient(to right, #c471f5, #fa71cd);
      padding: 30px;
      text-align: center;
      color: white;
      font-size: 24px;
      font-weight: bold;
      border-bottom-left-radius: 20px;
      border-bottom-right-radius: 20px;
    }
    .book-card {
      background: white;
      border-radius: 15px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      padding: 20px;
      margin-bottom: 20px;
    }
    .btn-gradient {
      background: linear-gradient(to right, #c471f5, #fa71cd);
      color: white;
      border: none;
    }
    .footer {
      background: #ddd;
      text-align: center;
      padding: 15px;
      font-weight: 500;
      margin-top: 40px;
      border-top-left-radius: 10px;
      border-top-right-radius: 10px;
    }
  </style>
</head>
<body>

  <div class="header">
    View Issued Books
    <p style="font-size: 16px; margin-top: 5px;">See the books you've issued and return dates</p>
  </div>

  <div class="container mt-5">
    <!-- Example Book Card -->
    <table class="table table-bordered">
            <thead>
              <tr>
                <th>Book Id</th>
                <th>Title</th>
                <th>Author</th>
                <th>Catagory</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="tBody">
            <%
                if(data.length==0){
            %>
            <tr><td colspan="6"><h1>There is no data present in database </h1></td></tr>
            <%
                }
                else{
                data.forEach((item,index)=>{
            %>  
            <tr>
                <td><%=(index+1)%></td>
                <td><%=item.title%></td>
                <td><%=item.author%></td>
                <td><%=item.category%></td>
                <td><%=item.status%></td>
                <td>
                   <form action="/requestbook" method="POST">
                    <input type="hidden" name="student_id" value="<%= item.id %>">
                    <input type="hidden" name="book_id" value="<%= item.id %>">
                    <button type="submit" class="btn btn-danger">Request book</button>
                   </form>
                   </td>



            </tr>
            
            <%
                });
            }
            %>
            
        </tbody>
          </table>
  </div>

  <div class="footer">
    © 2025 Library Management System
  </div>

</body>
</html>
