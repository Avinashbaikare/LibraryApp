<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-2 sidebar">
        <h3 class="text-center py-3"></h3>

        <a href="/admindashboard" class="active">Dashboard</a>
        <a href="#">Profile</a>
        <a href="/addbooks">Add Books</a>
        <a href="/viewbooks">Manage Books</a>
        <a href="#">Notifications</a>
        <a href="#">Users Management</a>
        <a href="#">Settings</a>
        <a href="#">Database Backup</a>
      </div>
      <div class="col-md-10">
        <div class="header d-flex justify-content-between align-items-center">
          <h4>Admin Dashboard</h4>
          <div>Hi, Admin  </div>
        </div>

        <div class="row mt-4 px-3">
          <div class="col-md-3">
            <div class="card-stats card-members">
              <h3>0</h3>
              <p>Total Members</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-stats card-books">
              <h3>0</h3>
              <p>Total Books</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-stats card-issued">
              <h3>0</h3>
              <p>Issue Books</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-stats card-returned">
              <h3>0</h3>
              <p>Return Books</p>
            </div>
          </div>
        </div>

        <div class="px-4 mt-5">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5>Recents Circulations</h5>
            <button class="btn btn-primary">+ Add Issue</button>
          </div>
          <table class="table table-bordered">
            <thead>
              <tr>
                <th>Member ID</th>
                <th>Book ID</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td colspan="7" class="text-center">No data available in table</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
