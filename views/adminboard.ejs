<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-2 sidebar">
        <h3 class="text-center py-3"></h3>

        <a href="/admindashboard?uid=<%=msg.uid%>" class="active">Dashboard</a>
        <a href="/adminprofile?uid=<%=msg.uid%>">Profile</a>
        <a href="/addbooks?uid=<%=msg.uid%>">Add Books</a>
        <a href="/viewbooks?uid=<%=msg.uid%>">Manage Books</a>
        <a href="/viewmembers?uid=<%=msg.uid%>">View Members</a>
        <a href="/adminlogin">Logout</a>
        
      </div>
      <div class="col-md-10">
        <div class="header d-flex justify-content-between align-items-center">
          <h4>Admin Dashboard</h4>
          <div>Hello, Admin <%=msg.uname%>  </div>
        </div>

        <div class="row mt-4 px-3">
          <div class="col-md-3">
            <div class="card-stats card-members">
              <h3>0</h3>
              <p>Total Members</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-stats card-books">
              <h3>0</h3>
              <p>Total Books</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-stats card-issued">
              <h3>0</h3>
              <p>Issue Books</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-stats card-returned">
              <h3>0</h3>
              <p>Return Books</p>
            </div>
          </div>
        </div>

       
          
        </div>
      </div>
    </div>
  </div>
</body>
</html>
