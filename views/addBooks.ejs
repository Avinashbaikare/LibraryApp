 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
    <style>
        .form-control{
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-2 sidebar">
        <h3 class="text-center py-3"></h3>
        <a href="/admindashboard?uid=<%=data.uid%>" class="active">Dashboard</a>
        <a href="/adminprofile?uid=<%=data.uid%>">Profile</a>
        <a href="/addbooks?uid=<%=data.uid%>">Add Books</a>
        <a href="/viewbooks?uid=<%=data.uid%>">Manage Books</a>
        <a href="/viewmembers?uid=<%=data.uid%>">View Members</a>
        <a href="/adminlogin">Logout</a>
       
      </div>
      <div class="col-md-10">
        <div class="header d-flex justify-content-between align-items-center">
          <h4>Admin Dashboard</h4>
          <div>Hello, Admin <%=data.uname%></div>
        </div>

        

       <form name="frm" action="/postbook" method="post" style="margin-top: 10px;">
    <div class="form-group">
        <input type="text" class="form-control" name="btitle"  id="title" placeholder="Enter Book Title" >
    </div>  
    <div class="form-group">
       <input type="text" class="form-control" name="bauthor"  id="author" placeholder="Enter Author Name" >
    </div> 
    <div class="form-group">
      <input type="text" class="form-control" name="bpublisher"  id="publilsher" placeholder="Enter publilsher " >
    </div>  
     <div class="form-group">
        <input type="text" class="form-control" name="isbn"  id="ISBN" placeholder="Enter ISBN Code" >
    </div>  
     <div class="form-group">
        <input type="text" class="form-control" name="bcatagory"  id="category" placeholder="Enter Catagory" >
    </div> 
    <div class="form-group">
        <input type="text" class="form-control" name="btotalcopies"  id="totalcopies" placeholder="Enter No.of Copies" >
    </div> 
    <div class="form-group">
        <input type="text" class="form-control" name="bavailablecopies"  id="availablecopies" placeholder="Enter NO.of Available Copies " >
    </div> 
     <div class="form-group">
        <input type="text" class="form-control" name="bstatus"  id="status" placeholder="Enter Status Available Or Not " >
    </div> 
    <div class="form-group">
        <input type="submit" class="form-control" id="ns" value="Add Book">
    </div> 
      <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong><%=msg%></strong>
            
          </div>
    </form> 
      </div>
    </div>
  </div>
</body>
</html>

 