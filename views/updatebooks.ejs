<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    <style>
        .form-control{
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <form name="frm" action="/saveupdatebook?id=<%=data1.id%>" method="post" style="margin-top: 10px;">
         <div class="form-group" >
            <input type="hidden" class="form-control" name="bookid"  id="title" value="<%=data1.id%>" >
        </div>  
        <div class="form-group" >
            <input type="text" class="form-control" name="btitle"  id="title" value="<%=data1.title%>" >
        </div>  
        <div class="form-group">
        <input type="text" class="form-control" name="bauthor"  id="author" value="<%=data1.author%>" >
        </div> 
        <div class="form-group">
        <input type="text" class="form-control" name="bpublisher"  id="publilsher"value="<%=data1.publisher%>" >
        </div>  
        <div class="form-group">
            <input type="text" class="form-control" name="isbn"  id="ISBN" value="<%=data1.isbn%>" >
        </div>  
        <div class="form-group">
            <input type="text" class="form-control" name="bcategory"  id="category" value="<%=data1.category%>" >
        </div> 
        <div class="form-group">
            <input type="text" class="form-control" name="btotalcopies"  id="totalcopies" value="<%=data1. total_copies%>" >
        </div> 
        <div class="form-group">
            <input type="text" class="form-control" name="bavailablecopies"  id="availablecopies" value="<%=data1.available_copies%>" >
        </div> 
        <div class="form-group">
            <input type="text" class="form-control" name="bstatus"  id="status" value="<%=data1.status%>" >
        </div> 
        <div class="form-group">
            <input type="submit" class="form-control" id="ns" value="Update Book">
        </div> 
      <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong><%=msg%></strong>
            
          </div>
    </form> 
</body>
</html>