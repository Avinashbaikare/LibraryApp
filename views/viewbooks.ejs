<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-2 sidebar">
        <h3 class="text-center py-3"></h3>
        <a href="#" class="active">Dashboard</a>
        <a href="#">Profile</a>
        <a href="/addbooks">Add Books</a>
        <a href="/viewbooks">View Books</a>
        <a href="#">Notifications</a>
        <a href="#">Users Management</a>
        <a href="#">Settings</a>
        <a href="#">Database Backup</a>
      </div>
      <div class="col-md-10">
        <div class="header d-flex justify-content-between align-items-center">
          <h4>Admin Dashboard</h4>
          <div></div>
        </div>

        

        <div class="px-4 mt-5">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5>Recents Circulations</h5>
            <button class="btn btn-primary">+ Add Issue</button>
          </div>
          <table class="table table-bordered">
            <thead>
              <tr>
                <th>Book Id</th>
                <th>Title</th>
                <th>Author</th>
                <th>Publilsher</th>
                <th>ISBN Code</th>
                <th>Catagory</th>
                <th>Total Copies</th>
                <th>Available Copies</th>
                <th>Status</th>
                <th>Created At</th>
              </tr>
            </thead>
            <tbody id="tBody">
            <%
                if(data.length==0){
            %>
            <tr><td colspan="6"><h1>There is no data present in database </h1></td></tr>
            <%
                }
                else{
                data.forEach((item,index)=>{
            %>  
            <tr>
                <td><%=(index+1)%></td>
                <td><%=item.title%></td>
                <td><%=item.author%></td>
                <td><%=item.publisher%></td>
                <td><%=item.isbn%></td>
                <td><%=item.category%></td>
                <td><%=item.total_copies%></td>
                <td><%=item.available_copies%></td>
                <td><%=item.status%></td>
                <td><%=item.created_at%></td>
              
               
            </tr>
            
            <%
                });
            }
            %>
            
        </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
