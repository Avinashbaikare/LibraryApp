<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #f5f5f5;
    }
    .sidebar {
      background-color: #ffffff;
      min-height: 100vh;
      border-right: 1px solid #ddd;
      padding: 20px 0;
    }
    .sidebar a {
      display: block;
      padding: 10px 20px;
      color: #333;
      text-decoration: none;
      transition: background-color 0.3s;
    }
    .sidebar a:hover,
    .sidebar a.active {
      background-color: #eee;
      font-weight: bold;
    }
    .topbar {
      background: linear-gradient(to right, #1e90ff, #ff3e3e);
      color: white;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .card-box {
      padding: 20px;
      border-radius: 10px;
      color: white;
      text-align: center;
    }
    .bg-members { background: linear-gradient(to bottom, #a18cd1, #fbc2eb); }
    .bg-books { background: linear-gradient(to bottom, #00c9ff, #92fe9d); }
    .bg-issue { background: linear-gradient(to bottom, #f85032, #e73827); }
    .bg-return { background: linear-gradient(to bottom, #96fbc4, #f9f586); }
    .table-box {
      background-color: white;
      padding: 20px;
      border-radius: 10px;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <div class="col-md-2 sidebar">
      <h4 class="text-center fw-bold">ApicStudio</h4>
      <a href="#" class="active"><i class="fas fa-tachometer-alt me-2"></i> Dashboard</a>
      <a href="#"><i class="fas fa-user me-2"></i> Profile</a>
      <a href="#"><i class="fas fa-book me-2"></i> Library</a>
      <a href="#"><i class="fas fa-paper-plane me-2"></i> Book Requests</a>
      <a href="#"><i class="fas fa-bell me-2"></i> Notifications</a>
      <a href="#"><i class="fas fa-users me-2"></i> Users Management</a>
      <a href="#"><i class="fas fa-cog me-2"></i> Settings</a>
      <a href="#"><i class="fas fa-database me-2"></i> Database Backup</a>
    </div>

    <!-- Main Content -->
    <div class="col-md-10">
      <!-- Top Bar -->
      <div class="topbar">
        <h4 class="m-0">Dashboard</h4>
        <div>Hi, Mr. Admin <i class="fas fa-user-circle ms-2"></i></div>
      </div>

      <div class="container mt-4">
        <div class="row g-4">
          <div class="col-md-3">
            <div class="card-box bg-members">
              <h3>0</h3>
              <p>Total Members</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-box bg-books">
              <h3>0</h3>
              <p>Total Books</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-box bg-issue">
              <h3>0</h3>
              <p>Issue Books</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card-box bg-return">
              <h3>0</h3>
              <p>Return Books</p>
            </div>
          </div>
        </div>

        <div class="table-box mt-5">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5>Recents Circulations</h5>
            <button class="btn btn-primary btn-sm">+ Add Issue</button>
          </div>
          <table class="table table-bordered">
            <thead class="table-light">
              <tr>
                <th>Member ID</th>
                <th>Book ID</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td colspan="7" class="text-center">No data available in table</td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
</body>
</html>
