<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
    
</head>
<body>
    
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-2 sidebar">
        <h3 class="text-center py-3"></h3>
         <a href="/admindashboard?uid=<%=data1.uid%>" class="active"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a>
        <a href="/adminprofile?uid=<%=data1.uid%>"><i class="fas fa-user me-2"></i>Profile</a>
        <a href="/addbooks?uid=<%=data1.uid%>"><i class="fas fa-paper-plane me-2"></i>Add Books</a>
        <a href="/viewbooks?uid=<%=data1.uid%>"><i class="fa-solid fa-book-open-reader"></i> Manage Books</a>
        <a href="/issueboard?uid=<%=data1.uid%>"><i class="fas fa-bell me-2"></i></i>Issue book requests</a>
        <a href="/viewmembers?uid=<%=data1.uid%>"><i class="fas fa-users me-2"></i>View Members</a>
        <a href="/adminlogin"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
        
      </div>
      <div class="col-md-10">
        <div class="header d-flex justify-content-between align-items-center">
          <h4>Admin Dashboard</h4>
          <div>Hello, Admin <%=data1.uname%></div>
        </div>

        

        <div class="px-4 mt-5">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5>Recents Circulations</h5>
            <button class="btn btn-primary">+ Add Issue</button>
          </div>
          <table class="table">
    <thead>
        <tr>
            <th>Request ID</th>
            <th>Student Name</th>
            <th>Book ID</th>
            <th>Book Title</th>
            <th>Request Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% if (data && data.length > 0) { %>
            <% data.forEach(function(item) { %>
                <tr>
                    <td><%= item.request_id %></td>
                    <td><%= item.name %></td>
                    <td><%= item.book_id %></td>
                    <td><%= item.title %></td>
                    <td><%= item.request_date.toDateString() %></td>
                    <td><%= item.status %></td>
                    <td>
    <!-- Approve Button -->
   <form action="/approveRequest?uid=<%=data1.uid%>" method="POST" style="display:inline;">
    <input type="hidden" name="request_id" value="<%= item.request_id%>">
    <button type="submit" class="btn btn-success btn-sm">Approve</button>
</form>

    <!-- Reject Button -->
     <form action="/rejectRequest?uid=<%=data1.uid%>" method="POST" style="display:inline;">
    <input type="hidden" name="request_id" value="<%= item.request_id %>">
    <button type="submit" class="btn btn-danger btn-sm">Reject</button>
</form>
</td>



                </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="6">No Pending Requests</td>
            </tr>
        <% } %>
    </tbody>
</table>

        </div>
      </div>
    </div>
  </div>
</body>
</html>
