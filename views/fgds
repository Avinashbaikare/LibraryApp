class RegServices {
    acceptRegdata(name, email, password, phone, address, date) {
        // Trim all values
        name = name?.trim();
        email = email?.trim();
        password = password?.trim();
        phone = phone?.trim();
        address = address?.trim();
        date = date?.trim();

        // Regular Expressions
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        const phoneRegex = /^[6-9]\d{9}$/; // Indian mobile format
        const passwordRegex = /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*#?&]{6,}$/;

        // Basic field validations
        if (!name || name.length < 3) {
            return "Invalid name. Must be at least 3 characters.";
        }

        if (!email || !emailRegex.test(email)) {
            return "Invalid email format.";
        }

        if (!password || !passwordRegex.test(password)) {
            return "Password must be at least 6 characters, include letters and numbers.";
        }

        if (!phone || !phoneRegex.test(phone)) {
            return "Invalid phone number. Must be 10 digits starting with 6-9.";
        }

        if (!address || address.length < 5) {
            return "Address must be at least 5 characters.";
        }

        if (!date || isNaN(new Date(date).getTime())) {
            return "Invalid date format.";
        }

        // All validations passed
        let result = regmodule.saveUser(name, email, password, phone, address, date);
        return result ? "Registration Success" : "Registration Failed";
    }
}
