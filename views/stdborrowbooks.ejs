<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
<div class="container-fluid">
    <div class="row">
        <div class="col-md-2 sidebar">
            <h3 class="text-center py-3"></h3>
            <a href="/userdashboard?id=<%=data1.id%>" class="active">Dashboard</a>
            <a href="/userprofile?id=<%=data1.id%>">Profile</a>
            <a href="/studviewbook?id=<%=data1.id%>">View Books</a>
            <a href="/issubook?id=<%=data1.id%>">Issue  Books</a>
            <a href="/borrowbooks?id=<%=data1.id%>">My Borrow Books</a>
            <a href="/userLogin">Logout</a>
            
        </div>  
     <div class="col-md-10">
        <div class="header d-flex justify-content-between align-items-center">
            <h4>User Dashboard</h4>
            <div>Hello,<%=data1.name%>  </div>
        </div>
         <div class="px-4 mt-5">
          <table class="table table-bordered">
            <thead>
              <tr>
                <th>Book Id</th>
                <th>image</th>
                <th>Title</th>
                <th>Author</th>
              </tr>
            </thead>
            <tbody id="tBody">
            <%
                if(data.length==0){
            %>
            <tr><td colspan="4"><h1>There is no data present in database </h1></td></tr>
            <%
                }
                else{
                data.forEach((item,index)=>{
            %>  
            <tr style="text-align: center; vertical-align: middle;">
                <td ><%=(index+1)%></td>
                <td><img src="<%=item.image%>" style="width: 100px; height: 150px;" ></td>
                <td><%=item.title%></td>
                <td><button>Read Book</button></td>
            </tr>
            
            <%
                });
            }
            %>
            
        </tbody>
          </table>
        </div>
     </div> 
    </div>
    
</div>
</body>
</html>
