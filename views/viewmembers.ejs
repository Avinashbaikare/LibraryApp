<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Library Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-2 sidebar">
        <h3 class="text-center py-3"></h3>
        <a href="/admindashboard?uid=<%=data1.uid%>" class="active"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a>
        <a href="/adminprofile?uid=<%=data1.uid%>"><i class="fas fa-user me-2"></i>Profile</a>
        <a href="/addbooks?uid=<%=data1.uid%>"><i class="fas fa-paper-plane me-2"></i>Add Books</a>
        <a href="/viewbooks?uid=<%=data1.uid%>"><i class="fas fa-bell me-2"></i>Manage Books</a>
        <a href="/viewmembers?uid=<%=data1.uid%>"><i class="fas fa-users me-2"></i>View Members</a>
        <a href="/adminlogin"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
        
      </div>
      <div class="col-md-10">
        <div class="header d-flex justify-content-between align-items-center">
          <h4>Admin Dashboard</h4>
          <div>Hello, Admin <%=data1.uname%></div>
        </div>

        

        <div class="px-4 mt-5">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5>Recents Circulations</h5>
            <button class="btn btn-primary">+ Add Issue</button>
          </div>
          <table class="table table-bordered">
            <thead>
              <tr>
                <th>Member Id</th>
                <th>name</th>
                <th>email</th>
                <th>phone</th>
                <th>address</th>
                <th>Created At</th>
                <th>update</th>
                <th>delete</th>
              </tr>
            </thead>
            <tbody id="tBody">
            <%
                if(data.length==0){
            %>
            <tr><td colspan="6"><h1>There is no data present in database </h1></td></tr>
            <%
                }
                else{
                data.forEach((item,index)=>{
            %>  
            <tr>
                <td><%=(index+1)%></td>
                <td><%=item.name%></td>
                <td><%=item.email%></td>
                <td><%=item.phone%></td>
                <td><%=item.address%></td>
                <td><%=item.created_at%></td>
                <td><a href="#">update</a> </td>
                <td><a href="#">Delete</a></td>
              
               
            </tr>
            
            <%
                });
            }
            %>
            
        </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
